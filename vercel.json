{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/fetch-data", "destination": "/api/fetch-data.js" },
    { "source": "/api/upload", "destination": "/api/upload.js" },
    { "source": "/api/media", "destination": "/api/media.js" }
  ]
}
